# ============================================================
# LLM endpoint — Ollama on the GPU machine
# ============================================================
#
# SCENARIO A — Code is running ON the GPU machine itself
#   Ollama is local, no override needed.
#   Leave LLM_BASE_URL commented out; config/config.yaml defaults
#   to http://localhost:11434/v1 automatically.
#
# SCENARIO B — Code is running on a CLIENT machine (Mac / Windows / Linux)
#   Set LLM_BASE_URL to the GPU machine's IP so inference calls
#   reach the remote Ollama instance.
#   Both the reasoning model and the coding model share this one URL;
#   Ollama picks the right model from the name in each request.
#
# --- Uncomment ONE of the lines below to match your scenario ---
#
# Scenario A (GPU machine, localhost):
# LLM_BASE_URL=http://localhost:11434/v1
#
# Scenario B (client machine, replace with actual GPU machine IP):
# LLM_BASE_URL=http://<GPU_MACHINE_IP>:11434/v1
#
# If neither is set, the value in config/config.yaml is used (localhost default).

# API key — "not-needed" for plain LAN Ollama.
# Set a real bearer token only if Ollama sits behind an auth proxy.
LLM_API_KEY=not-needed

# Paths
DRAFT_DIR=./tools/draft
STAGED_DIR=./tools/staged
ACTIVE_DIR=./tools/active
REGISTRY_PATH=./registry/tools.json

# Sandbox
# subprocess: works on all platforms (Mac, Windows, Linux) — no Docker needed
# docker:     stronger isolation, requires Docker on the client machine
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT_MB=512

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log
