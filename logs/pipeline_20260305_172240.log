from fastmcp import FastMCP
import pandas as pd
import time
import numpy as np
from scipy.stats import chi2_contingency

mcp = FastMCP("data_analysis_tools")


@mcp.tool()
def injury_distribution_chi_square(file_path: str):
    try:
        # Load data
        df = pd.read_csv(file_path)

        # Check for required columns
        required_columns = [
            "injuries_total",
            "injuries_fatal",
            "injuries_incapacitating",
            "injuries_non_incapacitating",
            "injuries_reported_not_evident",
            "injuries_no_indication",
        ]
        missing_columns = [col for col in required_columns if col not in df.columns]
        if missing_columns:
            raise ValueError(f"Missing required columns: {missing_columns}")

        # Drop rows with NaN values in required columns
        df = df[required_columns].dropna()

        # Create a contingency table
        # Assuming groups are defined by a categorical column, which is not provided in the spec.
        # For demonstration, let's assume there's a 'group' column in the data.
        if "group" not in df.columns:
            raise ValueError(
                "Data must contain a 'group' column to perform chi-square test."
            )

        contingency_table = pd.crosstab(df["group"], df[required_columns])

        # Filter groups with <2 samples
        contingency_table = contingency_table.loc[contingency_table.sum(axis=1) >= 2]

        # Ensure there are at least 2 groups
        if len(contingency_table) < 2:
            raise ValueError(
                "There must be at least 2 groups with sufficient samples to perform chi-square test."
            )

        # Perform chi-square test of independence
        chi2_stat, p_value, dof, expected = chi2_contingency(contingency_table)

        # Prepare result and metadata
        result = {
            "chi2_statistic": chi2_stat,
            "p_value": p_value,
            "degrees_of_freedom": dof,
        }
        metadata = {
            "contingency_table": contingency_table.to_dict(),
            "expected_frequencies": expected.tolist(),
        }

        return {"result": result, "metadata": metadata}

    except Exception as e:
        return {"result": {}, "metadata": {"error": str(e)}}

