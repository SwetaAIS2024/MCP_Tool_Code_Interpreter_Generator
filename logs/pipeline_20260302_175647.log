from fastmcp import FastMCP
import pandas as pd
import time
import numpy as np
from sklearn.preprocessing import MinMaxScaler

mcp = FastMCP("data_analysis_tools")


@mcp.tool()
def crash_severity_custom_transform(file_path: str):
    try:
        # Load the data from CSV file
        df = pd.read_csv(file_path)

        # Check for required columns
        required_columns = [
            "injuries_total",
            "injuries_fatal",
            "num_units",
            "trafficway_type",
        ]
        if not all(column in df.columns for column in required_columns):
            raise ValueError(
                f"CSV must contain the following columns: {required_columns}"
            )

        # Drop rows with missing values in required columns
        df = df[required_columns].dropna()

        # Ensure data types are correct
        if not (
            pd.api.types.is_numeric_dtype(df["injuries_total"])
            and pd.api.types.is_numeric_dtype(df["injuries_fatal"])
            and pd.api.types.is_numeric_dtype(df["num_units"])
        ):
            raise ValueError(
                "Columns 'injuries_total', 'injuries_fatal', and 'num_units' must be numeric."
            )

        # Calculate crash severity index
        df["crash_severity_index"] = (
            df["injuries_fatal"] * 2 + df["injuries_total"]
        ) / df["num_units"]

        # Normalize the crash severity index using Min-Max Scaler
        scaler = MinMaxScaler()
        df["normalized_crash_severity_index"] = scaler.fit_transform(
            df[["crash_severity_index"]]
        )

        # Group by trafficway_type and calculate average normalized crash severity index
        grouped_results = (
            df.groupby("trafficway_type")["normalized_crash_severity_index"]
            .mean()
            .reset_index()
        )

        # Sort the results in descending order based on average crash severity index
        sorted_results = grouped_results.sort_values(
            by="normalized_crash_severity_index", ascending=False
        )

        # Prepare the result and metadata
        result = {"trafficway_type_ranking": sorted_results.to_dict(orient="records")}
        metadata = {
            "columns_used": required_columns,
            "num_records_processed": len(df),
            "num_unique_trafficway_types": len(sorted_results),
        }

        return {"result": result, "metadata": metadata}

    except Exception as e:
        return {"result": {}, "metadata": {"error": str(e)}}

