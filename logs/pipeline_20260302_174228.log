from fastmcp import FastMCP
import pandas as pd
import time
import numpy as np
from scipy.stats import shapiro, ttest_ind, mannwhitneyu, cohen_d

mcp = FastMCP("data_analysis_tools")


@mcp.tool()
def intersection_injury_comparison(file_path: str):
    try:
        # Load data and select required columns
        df = pd.read_csv(file_path)
        required_columns = ["intersection_related_i", "injuries_total"]

        if not all(column in df.columns for column in required_columns):
            raise ValueError(
                f"CSV file must contain the following columns: {required_columns}"
            )

        df = df[required_columns].dropna()

        # Split data into two groups
        group_intersection = df[df["intersection_related_i"] == "Y"]["injuries_total"]
        group_non_intersection = df[df["intersection_related_i"] != "Y"][
            "injuries_total"
        ]

        # Filter out groups with less than 2 samples
        if len(group_intersection) < 2 or len(group_non_intersection) < 2:
            raise ValueError("Each group must have at least 2 samples.")

        # Check normality of distributions
        _, p_value_intersection = shapiro(group_intersection)
        _, p_value_non_intersection = shapiro(group_non_intersection)

        is_normal_intersection = p_value_intersection > 0.05
        is_normal_non_intersection = p_value_non_intersection > 0.05

        # Perform appropriate statistical test
        if is_normal_intersection and is_normal_non_intersection:
            test_result = ttest_ind(group_intersection, group_non_intersection)
            statistic = test_result.statistic
            p_value = test_result.pvalue
            effect_size = cohen_d(group_intersection, group_non_intersection)
            test_used = "t-test"
        else:
            test_result = mannwhitneyu(group_intersection, group_non_intersection)
            statistic = test_result.statistic
            p_value = test_result.pvalue
            # Effect size for Mann-Whitney U can be calculated using r (rank-biserial correlation)
            effect_size = (
                2
                * test_result.statistic
                / (len(group_intersection) * len(group_non_intersection))
            )
            test_used = "mann-whitney-u"

        significant = p_value < 0.05

        # Prepare result dictionary
        result = {
            "statistic": statistic,
            "p_value": p_value,
            "significant": significant,
            "effect_size": effect_size,
            "group_means": {
                "intersection": group_intersection.mean(),
                "non_intersection": group_non_intersection.mean(),
            },
            "test_used": test_used,
        }

        metadata = {
            "normality_test_results": {
                "intersection_related_i_Y": p_value_intersection,
                "intersection_related_i_not_Y": p_value_non_intersection,
            }
        }

        return {"result": result, "metadata": metadata}

    except Exception as e:
        return {"result": {}, "metadata": {"error": str(e)}}

